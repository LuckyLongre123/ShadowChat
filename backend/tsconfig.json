{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "types": ["node"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*"
  ]
}
